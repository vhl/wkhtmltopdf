#!/usr/bin/env ruby
require 'wkhtmltopdf'

machine = `uname -m`.chomp
linux = RUBY_PLATFORM.include?('linux')
darwin = RUBY_PLATFORM.include?('darwin')

executable =
  if linux && %w[aarch64 arm64].include?(machine)
    'wkhtmltopdf_aarch64'
  elsif linux && %w[x86_64 amd64].include?(machine)
    'wkhtmltopdf_64bit'
  elsif linux
    'wkhtmltopdf_linux_386'
  elsif darwin && %w[x86_64 amd64].include?(machine)
    'wkhtmltopdf_darwin_64bit'
  elsif darwin
    'wkhtmltopdf_darwin_386'
  else
    raise "Invalid platform. Must be running linux or intel-based Mac OS. " \
          "(RUBY_PLATFORM=#{RUBY_PLATFORM.inspect}, uname -m=#{machine.inspect})"
  end

executable = File.join(File.dirname(__FILE__), executable)
unless File.executable?(executable)
  raise "wkhtmltopdf binary not found or not executable: #{executable} " \
        "(RUBY_PLATFORM=#{RUBY_PLATFORM.inspect}, uname -m=#{machine.inspect})"
end

exec(executable, *ARGV)
